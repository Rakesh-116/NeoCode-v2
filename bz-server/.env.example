# Container names used for code execution workers
# Customize these if you use different container names when running Docker
PYTHON_CONTAINER_NAME=python-container
JAVA_CONTAINER_NAME=java-container
CPP_CONTAINER_NAME=cpp-container

# Optional: path to workers directory relative to bz-server (default: src/workers)
WORKERS_DIR=src/workers

# ============================================================================
# AI/LLM Configuration
# ============================================================================

# --------------------------------------------------------------------------
# AI Feature Flags
# --------------------------------------------------------------------------
# Enable/disable individual AI features
ENABLE_AI_COACH=true          # AI learning coach
ENABLE_AI_INTERVIEW=true      # AI technical interviewer
ENABLE_AI_CODE_REVIEW=true    # AI code review on submissions
ENABLE_AI_SUPPORT=true        # AI support chatbot

# --------------------------------------------------------------------------
# AI Provider Configuration
# --------------------------------------------------------------------------
# Default provider: "local" (Ollama), "openai", or "gemini"
AI_DEFAULT_PROVIDER=local

# Request settings
AI_REQUEST_TIMEOUT=30000      # Timeout in milliseconds (30 seconds)
AI_MAX_RETRIES=2              # Number of retries on failure

# Cache settings
AI_CACHE_ENABLED=true         # Enable response caching
AI_CACHE_EXPIRY=86400         # Cache expiry in seconds (24 hours)

# --------------------------------------------------------------------------
# Ollama (Local LLM) - FREE & PRIVATE
# --------------------------------------------------------------------------
# Install Ollama: https://ollama.ai/
# Pull Orca Mini: ollama pull orca-mini
# Start service: ollama serve

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=orca-mini        # Or: llama2, codellama, mistral, etc.
OLLAMA_TEMPERATURE=0.2        # Randomness (0-1, lower = more focused)

# --------------------------------------------------------------------------
# OpenAI (Cloud LLM) - PAID
# --------------------------------------------------------------------------
# Get API key: https://platform.openai.com/api-keys
# Leave empty if not using

OPENAI_API_KEY=               # Your OpenAI API key
OPENAI_MODEL=gpt-3.5-turbo    # Or: gpt-4, gpt-4-turbo
OPENAI_TEMPERATURE=0.2

# --------------------------------------------------------------------------
# Google Gemini (Cloud LLM) - FREE TIER AVAILABLE
# --------------------------------------------------------------------------
# Get API key: https://makersuite.google.com/app/apikey
# Leave empty if not using

GEMINI_API_KEY=               # Your Gemini API key
GEMINI_MODEL=gemini-2.0-flash # Or: gemini-pro
GEMINI_TEMPERATURE=0.2

# --------------------------------------------------------------------------
# Other Settings
# --------------------------------------------------------------------------
PORT=3000

# --------------------------------------------------------------------------
# Code Execution Provider
# --------------------------------------------------------------------------
CODE_EXECUTION_PROVIDER=docker
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here

